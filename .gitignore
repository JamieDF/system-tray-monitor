# Compiled schema, regenerated by glib-compile-schemas during development.
schemas/gschemas.compiled

# Machine-local editor and tooling config. A shared .claude/settings.json is
# fine to commit; the .local.json variant is per-machine by convention.
.claude/settings.local.json

# Build output from `gnome-extensions pack`.
*.shell-extension.zip

# Linting only. The extension itself has no build step and ships as plain
# JavaScript, so this never appears in a release.
node_modules/

# Fake /proc tree used by the process-list tests. Built at runtime into /tmp,
# but ignore this path too so a leftover local copy cannot be committed.
tests/fixtures/proc-processes/

*~
*.swp
